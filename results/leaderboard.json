    {
      "name": "car_lu",
      "icon": "\ud83e\udd89",
      "authors": [
        "Carmen Cuerva",
        "Luc\u00eda Arg\u00fcello"
      ],
      "description": "Bitboard negamax with alpha-beta, iterative deepening and a transposition table; never gives away an immediate win and scores threats by row parity (odd rows for the first player, even rows for the second). Plays the endgame perfectly."
    },
    {
      "name": "easy",
      "icon": "\ud83c\udf31",
      "authors": [
        "builtin"
      ],
      "description": "Looks one move ahead: takes an immediate win, blocks an immediate loss, and otherwise plays as close to the centre as it can. Walks straight into any double threat."
    },
    {
      "name": "hard",
      "icon": "\u2694\ufe0f",
      "authors": [
        "builtin"
      ],
      "description": "Minimax with alpha-beta pruning, searching 5 plies and then scoring every open line of four: two and three in a row with room to grow, for itself and against its rival. Strong, but blind to the long-term (odd/even row) threats experts play for."
    },
    {
      "name": "medium",
      "icon": "\ud83e\udde0",
      "authors": [
        "builtin"
      ],
      "description": "Minimax with alpha-beta pruning, searching 4 plies and then guessing from how many of its pieces sit near the centre. Never misses what it can see, but builds no threats of its own."
    },
